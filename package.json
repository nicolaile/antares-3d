{
	"name": "antares",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run check:system && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:system": "node scripts/check-system.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"optimize:model": "bash scripts/lab/optimize-model.sh",
		"convert:step": "bash scripts/lab/step-to-glb.sh",
		"tag:auto": "node --max-old-space-size=8000 scripts/lab/auto-tag-cad.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@gltf-transform/core": "^4.5.1",
		"@gltf-transform/extensions": "^4.5.1",
		"@gltf-transform/functions": "^4.5.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24.19.2",
		"@types/three": "^0.186.0",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"meshoptimizer": "^1.3.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"sharp": "^0.34.5",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"three-mesh-bvh": "^0.9.16",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.0.16",
		"vite-imagetools": "^9.0.3"
	},
	"dependencies": {
		"gsap": "^3.15.0",
		"lenis": "^1.3.26",
		"three": "^0.186.0"
	}
}
