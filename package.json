{
	"name": "antares",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run check:system && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:system": "node scripts/check-system.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"optimize:model": "bash scripts/optimize-model.sh",
		"convert:step": "bash scripts/step-to-glb.sh",
		"tag:auto": "node --max-old-space-size=8000 scripts/auto-tag-cad.mjs"
	},
	"devDependencies": {
		"@gltf-transform/core": "^4.5.1",
		"@gltf-transform/extensions": "^4.5.1",
		"@gltf-transform/functions": "^4.5.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/three": "^0.186.0",
		"meshoptimizer": "^1.3.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"gsap": "^3.15.0",
		"lenis": "^1.3.26",
		"three": "^0.186.0"
	}
}
