{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "antares",
			"runtimeExecutable": "/bin/zsh",
			"runtimeArgs": ["-lc", "exec npm run dev"],
			"autoPort": true
		},
		{
			"name": "antares-prod",
			"runtimeExecutable": "/bin/zsh",
			"runtimeArgs": ["-lc", "exec npm run preview -- --port 4173"],
			"port": 4173
		},
		{
			"name": "antares-lan",
			"runtimeExecutable": "/bin/zsh",
			"runtimeArgs": ["-lc", "exec npm run dev -- --host --port 5180"],
			"port": 5180
		}
	]
}
